# Fill in your endpoint details, then save this file.
# Lines starting with # are ignored.

SOVEREIGN_BASE_URL=https://***/platform/***
SOVEREIGN_MODEL=gpt-4-*
SOVEREIGN_API_KEY=sk-***

# Optional. Leave the path lines unset — the script anchors its defaults to
# its own location (scripts/../data, scripts/../results), so they resolve
# correctly no matter which directory you launch from. Only override them if
# you want a non-default location, using an ABSOLUTE path.
# SOVEREIGN_CSV_PATH=/absolute/path/to/test_cases.csv
# SOVEREIGN_OUTPUT_PREFIX=/absolute/path/to/results
SOVEREIGN_DELAY_SECONDS=0.5
